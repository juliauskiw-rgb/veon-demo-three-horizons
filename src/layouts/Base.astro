---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import { asset } from "../data/site";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;

// Self-hosted variable fonts (latin + cyrillic subsets, wght axis). Base-aware URLs so the demo works under a sub-path.
const face = (family: string, file: string, range: string, weights: string) =>
  `@font-face{font-family:"${family}";src:url("${asset(`fonts/${file}`)}") format("woff2");font-weight:${weights};font-style:normal;font-display:swap;unicode-range:${range}}`;
const CYR = "U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116";
const LAT = "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const fontCss = [
  face("Geologica", "geologica-cyrillic-wght-normal.woff2", CYR, "100 900"),
  face("Geologica", "geologica-latin-wght-normal.woff2", LAT, "100 900"),
  face("IBM Plex Sans", "ibm-plex-sans-cyrillic-wght-normal.woff2", CYR, "100 700"),
  face("IBM Plex Sans", "ibm-plex-sans-latin-wght-normal.woff2", LAT, "100 700"),
  `@font-face{font-family:"Geologica Fallback";src:local("Arial");size-adjust:104%;ascent-override:94%;descent-override:24%;line-gap-override:0%}`,
  `@font-face{font-family:"Plex Fallback";src:local("Arial");size-adjust:100%;ascent-override:102%;descent-override:27%;line-gap-override:0%}`,
].join("");
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#EDF0F2" />
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={asset("fonts/geologica-cyrillic-wght-normal.woff2")} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
<style is:global>
  /* Floor 4: kept next to <html>/<body> so the layout check sees it (also in global.css). */
  html { overflow-x: clip; }
  body { overflow-x: clip; }
</style>
