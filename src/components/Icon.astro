---
// Linear icons, 1.5 px stroke, no backgrounds (concept: icons minimal).
interface Props { name: "phone" | "telegram" | "menu" | "close" | "pin" | "mail"; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11.5 11.5 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5C10.6 20 4 13.4 3.5 5.1A1.5 1.5 0 0 1 5 3.5Z" />}
  {name === "telegram" && <path d="M21 4 3 11.2l6.3 2.2L18 7.5l-6.8 7.1.2 5.4 3.1-3.6 4.2 3.1L21 4Z" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h10" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "pin" && <><path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === "mail" && <><rect x="3.5" y="5.5" width="17" height="13" rx="1" /><path d="m4 6.5 8 6 8-6" /></>}
</svg>
