---
import FutureLink from "./FutureLink.astro";
import { contacts, socials } from "../data/site";
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">Медичний центр «Ортопедія VIP» лікаря Величка В. М.</p>
      <p class="site-footer__motto">Ми лікуємо не симптоми, а причину болю.</p>
    </div>
    <ul class="site-footer__contacts">
      <li><a class="link tnum" href={contacts.phoneHref}>{contacts.phoneText}</a></li>
      <li><a class="link" href={contacts.emailHref}>{contacts.email}</a></li>
      <li>{contacts.city}, {contacts.street}, {contacts.metro}</li>
    </ul>
    <ul class="site-footer__social" aria-label="Соцмережі" data-rec="S-R003">
      {socials.map((s) => <li><a class="link" href={s.href} rel="noopener" target="_blank" data-rec={"rec" in s ? s.rec : undefined}>{s.name}</a></li>)}
    </ul>
    <div class="site-footer__legal">
      <FutureLink>Політика конфіденційності</FutureLink>
      <p>© 2026 ФОП Величко Вячеслав Миколайович</p>
    </div>
  </div>
</footer>
